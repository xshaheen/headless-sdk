##########################################
# headless-sdk repository settings
#
# Generated by eng/tools/sync_root_editorconfig.py; do not edit by hand. Edit the shipped configs
# under src/Headless.NET.Sdk/configurations and run the script again.
#
# Editor settings come from the editorconfig.txt scaffold. This repository's own projects build
# with plain Microsoft.NET.Sdk and never receive the injected Headless.NET.Sdk.*.editorconfig
# files, so their analyzer settings are repeated in the sections at the end.
##########################################

# This file is the top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = false
indent_size = 4
tab_width = 4
indent_style = space
max_line_length = 120

##########################################
# Visual Studio Spell Checker
# https://learn.microsoft.com/visualstudio/ide/text-spell-checker
##########################################

# Note that you must have the relevant Windows language pack installed on your machine for this to work.
spelling_languages = en-us
spelling_error_severity = information

##########################################
# File Extension Settings
##########################################

# Visual Studio Solution Files
[*.sln]
indent_style = tab

# Verify settings
# https://github.com/VerifyTests/Verify?tab=readme-ov-file#text-file-settings
[*.{received,verified}.{txt,xml,json}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false

# Generated code
[*{_AssemblyInfo.cs,.notsupported.cs,.generated.cs}]
generated_code = true

# Razor and cshtml files
# UTF-8-BOM is set as default, as all official template files use UTF-8-BOM
# See https://github.com/dotnet/aspnetcore/pull/23502 and https://github.com/dotnet/aspnetcore/issues/22753
[*.{razor,cshtml}]
charset = utf-8-bom

# Visual Studio XML Project Files
[*.{csproj,vbproj,vcxproj.filters,proj,projitems,shproj}]
indent_size = 2

# XML Configuration Files
[*.{xml,config,props,targets,nuspec,resx,ruleset,vsixmanifest,vsct}]
indent_size = 2

# JSON Files
[*.{json,json5,webmanifest}]
indent_size = 2

# YAML Files
[*.{yml,yaml}]
indent_size = 2
tab_width = 2

# Markdown Files
[*.{md,mdx}]
trim_trailing_whitespace = false

# Web Files
[*.{htm,html,js,jsm,ts,tsx,cjs,cts,ctsx,mjs,mts,mtsx,css,sass,scss,less,pcss,svg,vue}]
indent_size = 2
insert_final_newline = true

# Batch Files
[*.{cmd,bat}]
end_of_line = crlf

# Bash Files
[*.sh]
end_of_line = lf

# Makefiles
[Makefile]
indent_style = tab

# min files don't reformatting
[*.min.*]
trim_trailing_whitespace = false
insert_final_newline = false

##########################################
# C# editor settings
##########################################

[*.cs]
insert_final_newline = true

# C# formatting options for editors; CSharpier owns the final layout.
# https://learn.microsoft.com/dotnet/fundamentals/code-analysis/style-rules/csharp-formatting-options

# Newline options
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
# Indentation options
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = no_change
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false
# Spacing options
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false
# Wrap options
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

##########################################
# ReSharper
#
# ReSharper and Rider options. ReSharper's own inspections do not use Roslyn diagnostic IDs, so
# the resharper_* keys tune them separately; they have no compiler impact. Extend per repo as needed.

# XML Docs
resharper_xmldoc_indent_child_elements = remove_indent
resharper_xmldoc_indent_text = remove_indent
resharper_xmldoc_blank_line_after_pi = true
resharper_xmldoc_space_before_self_closing = true
resharper_xmldoc_wrap_tags_and_pi = false
resharper_xmldoc_keep_user_linebreaks = true

# .NET align preferences
resharper_int_align_comments = true
resharper_align_multiline_binary_expressions_chain = false
resharper_int_align_fields = false
resharper_int_align_assignments = false
resharper_int_align_nested_ternary = false
resharper_int_align_switch_expressions = false
resharper_int_align_switch_sections = false
resharper_int_align_property_patterns = false

# Keep as its
resharper_keep_existing_primary_constructor_declaration_parens_arrangement = false
resharper_keep_existing_declaration_parens_arrangement = false
resharper_keep_existing_invocation_parens_arrangement = true
resharper_keep_existing_attribute_arrangement = true
resharper_keep_existing_linebreaks = true
resharper_keep_existing_arrangement = true
resharper_keep_existing_initializer_arrangement = true
resharper_keep_existing_embedded_arrangement = false
resharper_keep_existing_expr_member_arrangement = true
resharper_keep_existing_property_patterns_arrangement = false
resharper_keep_existing_switch_expression_arrangement = false

# Blank lines
resharper_enforce_line_ending_style = true
resharper_wrap_lines = false
resharper_keep_user_linebreaks = true
resharper_wrap_before_declaration_lpar = false
resharper_wrap_before_declaration_rpar = true
resharper_wrap_after_invocation_lpar = true
resharper_wrap_before_invocation_rpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_before_first_type_parameter_constraint = true
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_wrap_arguments_style = wrap_if_long
resharper_wrap_parameters_style = chop_if_long
resharper_wrap_before_binary_opsign = false
resharper_wrap_before_eq = false
resharper_wrap_before_first_type_parameter_constraint = true
resharper_wrap_verbatim_interpolated_strings = no_wrap
resharper_wrap_before_linq_expression = true
resharper_wrap_before_arrow_with_expressions = false
resharper_blank_lines_after_control_transfer_statements = 1
resharper_blank_lines_after_multiline_statements = 1
resharper_blank_lines_around_single_line_auto_property = 1
resharper_blank_lines_around_single_line_local_method = 1
resharper_blank_lines_around_single_line_property = 1
resharper_blank_lines_before_block_statements = 1
resharper_blank_lines_before_control_transfer_statements = 1
resharper_blank_lines_before_multiline_statements = 1

# Preferences
resharper_place_expr_accessor_on_single_line = true
resharper_place_expr_method_on_single_line = true
resharper_place_expr_property_on_single_line = true
resharper_arguments_skip_single = true
resharper_arguments_string_literal = named
resharper_outdent_commas = true
resharper_empty_block_style = together_same_line
resharper_nested_ternary_style = simple_wrap
resharper_place_simple_enum_on_single_line = true
resharper_place_linq_into_on_new_line = false
resharper_place_simple_accessorholder_on_single_line = true
resharper_braces_for_ifelse = required_for_multiline
resharper_arguments_literal = named
resharper_wrap_object_and_collection_initializer_style = chop_if_long
resharper_place_simple_embedded_statement_on_same_line = false
resharper_space_within_single_line_array_initializer_braces = true

# ReSharper inspection severities
resharper_arrange_redundant_parentheses_highlighting = hint
resharper_arrange_this_qualifier_highlighting = hint
resharper_arrange_type_member_modifiers_highlighting = hint
resharper_arrange_type_modifiers_highlighting = hint
resharper_built_in_type_reference_style_highlighting = hint
resharper_check_namespace_highlighting = warning
resharper_heap_view_can_avoid_closure_highlighting = hint
resharper_html_tag_not_closed_highlighting = warning
resharper_mvc_action_not_resolved_highlighting = suggestion
resharper_mvc_area_not_resolved_highlighting = suggestion
resharper_mvc_controller_not_resolved_highlighting = suggestion
resharper_mvc_invalid_model_type_highlighting = warning
resharper_mvc_partial_view_not_resolved_highlighting = suggestion
resharper_mvc_template_not_resolved_highlighting = suggestion
resharper_mvc_view_component_not_resolved_highlighting = suggestion
resharper_mvc_view_component_view_not_resolved_highlighting = suggestion
resharper_mvc_view_not_resolved_highlighting = suggestion
resharper_not_accessed_positional_property_global_highlighting = suggestion
resharper_razor_layout_not_resolved_highlighting = suggestion
resharper_redundant_argument_default_value_highlighting = suggestion
resharper_redundant_base_qualifier_highlighting = warning
resharper_redundant_suppress_nullable_warning_expression_highlighting = none
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_suggest_var_or_type_elsewhere_highlighting = hint
resharper_suggest_var_or_type_simple_types_highlighting = hint
resharper_unused_auto_property_accessor_global_highlighting = suggestion
resharper_unused_auto_property_accessor_local_highlighting = suggestion
resharper_unused_type_parameter_highlighting = suggestion

##########################################
# Test projects
##########################################

[tests/**/*.cs]

# ReSharper - DisposeOnUsingVariable
# Test objects often managed by test framework or intentionally not disposed
resharper_dispose_on_using_variable_highlighting = none
resharper_not_disposed_resource_highlighting = none
resharper_access_to_disposed_closure_highlighting = none
resharper_using_statement_resource_initialization_highlighting = none
# ReSharper AccessToModifiedClosure - Access to modified captured variable
resharper_access_to_modified_closure_highlighting = none
# ReSharper - ShortLivedHttpClient
resharper_short_lived_http_client_highlighting = none

##########################################
# Injected analyzer settings: Headless.NET.Sdk.Analyzers.editorconfig
##########################################

[*.cs]

############################################################
# .NET code quality (CA)
# AnalysisMode=All enables every CA rule as a warning; entries change that default.
############################################################

# CA1000: Do not declare static members on generic types
dotnet_diagnostic.CA1000.severity = suggestion
# CA1002: Do not expose generic lists (performance preference)
dotnet_diagnostic.CA1002.severity = none
# CA1008: Enums should have zero value
dotnet_diagnostic.CA1008.severity = suggestion
# CA1012: duplicate of MA0017, which also covers internal constructors
dotnet_diagnostic.CA1012.severity = none
# CA1019: Define accessors for attribute arguments
dotnet_diagnostic.CA1019.severity = suggestion
# CA1024: Use properties where appropriate
dotnet_diagnostic.CA1024.severity = suggestion
# CA1027: Mark enums with FlagsAttribute
dotnet_diagnostic.CA1027.severity = none
# CA1028: Enum Storage should be Int32
dotnet_diagnostic.CA1028.severity = suggestion
# CA1031: Do not catch general exception types
dotnet_diagnostic.CA1031.severity = none
# CA1032/RCS1194: Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = none
# CA1034: Nested types should not be visible
dotnet_diagnostic.CA1034.severity = none
# CA1036: A class that implements IComparable<T> or IComparable should override comparison operators
dotnet_diagnostic.CA1036.severity = suggestion
# CA1040: Avoid empty interfaces
dotnet_diagnostic.CA1040.severity = none
# CA1045: Do not pass types by reference
dotnet_diagnostic.CA1045.severity = suggestion
# CA1050: duplicate of MA0047, which also reports internal types outside a namespace
dotnet_diagnostic.CA1050.severity = none
# CA1054/CA1055/CA1056/CA2234: URI values should be System.Uri instead of strings
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA2234.severity = none
# CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = none
# CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = suggestion
# CA1304: Specify CultureInfo (duplicate of MA0011, which has a code fix)
dotnet_diagnostic.CA1304.severity = none
# CA1305: Specify IFormatProvider (duplicate of MA0011, which has a code fix)
dotnet_diagnostic.CA1305.severity = none
# CA1307: Specify StringComparison for clarity (duplicate of MA0001, which has a code fix)
dotnet_diagnostic.CA1307.severity = none
# CA1308: Normalize strings to uppercase
dotnet_diagnostic.CA1308.severity = none
# CA1309: Use ordinal StringComparison (duplicate of MA0001, which has a code fix)
dotnet_diagnostic.CA1309.severity = none
# CA1310: Specify StringComparison for correctness (duplicate of MA0074, which has a code fix)
dotnet_diagnostic.CA1310.severity = none
#
# CA1311: duplicate of MA0011 which has a code fix
dotnet_diagnostic.CA1311.severity = none
# CA1508: Avoid dead conditional code
# Flow analysis with frequent false positives on defensive checks, and one of the costliest CA
# rules to run.
dotnet_diagnostic.CA1508.severity = none
# CA1515: Consider making public types internal
dotnet_diagnostic.CA1515.severity = none
# CA1711: Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1711.severity = none
# CA1716: Identifiers should not match keywords
dotnet_diagnostic.CA1716.severity = none
# CA1720: Identifiers should not contain type names
dotnet_diagnostic.CA1720.severity = suggestion
# CA1724: Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = none
# CA1725: Parameter names should match base declaration
dotnet_diagnostic.CA1725.severity = suggestion
# CA1805: Do not initialize unnecessarily.
dotnet_diagnostic.CA1805.severity = suggestion
# CA1812: Avoid uninstantiated internal classes (DI-resolved types are invisible to the analyzer)
dotnet_diagnostic.CA1812.severity = none
# CA1819: Properties should not return arrays (performance preference)
dotnet_diagnostic.CA1819.severity = none
# CA1823: Avoid unused private fields
dotnet_diagnostic.CA1823.severity = suggestion
# CA1831|CA1832|CA1833: Use AsSpan or AsMemory instead of Range-based indexers when appropriate
dotnet_diagnostic.CA1831.severity = warning
# CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = silent
# CA1851: Possible multiple enumerations of 'IEnumerable' collection
dotnet_diagnostic.CA1851.severity = suggestion
# CA1859: Use concrete types when possible for improved performance
dotnet_diagnostic.CA1859.severity = suggestion
# CA1861: Avoid constant arrays as arguments
dotnet_diagnostic.CA1861.severity = suggestion
# CA1863: Cache a 'CompositeFormat' for repeated use in this formatting operation
dotnet_diagnostic.CA1863.severity = suggestion
# CA2002: keeps the error severity of the disabled MT1001/MT1002
dotnet_diagnostic.CA2002.severity = error
# CA2007: Consider calling ConfigureAwait — none by default (most Headless apps run without a
# SynchronizationContext); HeadlessEnforceConfigureAwait=true applies the EnforceConfigureAwait
# overlay (global_level 1), which raises this to warning.
dotnet_diagnostic.CA2007.severity = none
# CA2208: duplicate of MA0015, which reports more cases
dotnet_diagnostic.CA2208.severity = none
# CA2214: duplicate of MA0056, which also covers virtual properties and inherited members
dotnet_diagnostic.CA2214.severity = none
# CA2227: Collection properties should be read only
dotnet_diagnostic.CA2227.severity = silent
# CA5359: keeps the error severity of the disabled MA0039
dotnet_diagnostic.CA5359.severity = error
# CA5394: Do not use insecure randomness
dotnet_diagnostic.CA5394.severity = suggestion

############################################################
# .NET code style (IDE)
# Most IDE rules take their severity from the code-style options further down.
############################################################

# IDE0010/IDE0072: Add missing cases to switch statement/expression
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none
# IDE0055: Fix formatting (we use CSharpier)
dotnet_diagnostic.IDE0055.severity = none
# IDE0330: duplicate of MA0158
dotnet_diagnostic.IDE0330.severity = none

############################################################
# Meziantou.Analyzer (MA)
############################################################

# MA0001: StringComparison is missing
dotnet_diagnostic.MA0001.severity = warning
# MA0002: IEqualityComparer<string> or IComparer<string> is missing
dotnet_diagnostic.MA0002.severity = warning
MA0002.report_only_non_ordinal = true
# RCS1090/MA0004/VSTHRD111: Use .ConfigureAwait — CA2007 is the single source of truth
dotnet_diagnostic.MA0004.severity = none
# MA0005: duplicate of CA1825
dotnet_diagnostic.MA0005.severity = none
# MA0006: Use String.Equals instead of equality operator
dotnet_diagnostic.MA0006.severity = suggestion
# MA0007: conflicts with CSharpier trailing-comma formatting
dotnet_diagnostic.MA0007.severity = none
# MA0009: Add regex evaluation timeout
dotnet_diagnostic.MA0009.severity = warning
# MA0010: duplicate of CA1018
dotnet_diagnostic.MA0010.severity = none
# MA0011: IFormatProvider is missing
dotnet_diagnostic.MA0011.severity = warning
# MA0012: Do not raise reserved exception type
dotnet_diagnostic.MA0012.severity = warning
# MA0013: duplicate of CA1058
dotnet_diagnostic.MA0013.severity = none
# MA0014: duplicate of CA2201
dotnet_diagnostic.MA0014.severity = none
# MA0015: Specify the parameter name in ArgumentException
dotnet_diagnostic.MA0015.severity = warning
# MA0016: Prefer returning collection abstraction instead of implementation (performance preference)
dotnet_diagnostic.MA0016.severity = none
# MA0018/MA0038/MA0041/MA0097: deprecated in favor of CA1000/CA1822/CA1036
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0097.severity = none
# MA0021: Use StringComparer.GetHashCode instead of string.GetHashCode
dotnet_diagnostic.MA0021.severity = warning
# MA0022: Return Task.FromResult instead of returning null
dotnet_diagnostic.MA0022.severity = warning
# MA0024: Use an explicit StringComparer when possible
dotnet_diagnostic.MA0024.severity = warning
# MA0025: Implement the functionality (or raise NotSupportedException)
# A suggestion, not a warning: deliberate NotImplementedException placeholders, such as tests that
# exercise exception mapping, must not fail a build.
dotnet_diagnostic.MA0025.severity = suggestion
# MA0026: TO-DO comment
dotnet_diagnostic.MA0026.severity = suggestion
# MA0027: duplicate of CA2200
dotnet_diagnostic.MA0027.severity = none
# MA0029: duplicate of RCS1077
dotnet_diagnostic.MA0029.severity = none
# MA0040: duplicate of CA2016 (forward the CancellationToken). MA0032 also reports overloads
# when no token is in scope, which is noisy. MA0079/MA0080 cover IAsyncEnumerable.
dotnet_diagnostic.MA0040.severity = none
dotnet_diagnostic.MA0032.severity = none
# MA0033: duplicate of CA2259
dotnet_diagnostic.MA0033.severity = none
# MA0036: duplicate of CA1052
dotnet_diagnostic.MA0036.severity = none
# MA0037: Remove empty statement
dotnet_diagnostic.MA0037.severity = error
# MA0039: duplicate of CA5359
dotnet_diagnostic.MA0039.severity = none
# MA0042: duplicate of CA1849, which reports a superset of blocking calls in async code
dotnet_diagnostic.MA0042.severity = none
# MA0043: duplicate of CA1507
dotnet_diagnostic.MA0043.severity = none
# MA0044: duplicate of RCS1097
dotnet_diagnostic.MA0044.severity = none
# MA0045: Do not use blocking calls, even when the calling method must become async
# Advice for migrating sync code to async, not a defect. VSTHRD002 already reports synchronous
# task waits, and in measured consumers this was the most-suppressed analyzer rule.
dotnet_diagnostic.MA0045.severity = none
# MA0047: Declare types in namespaces
dotnet_diagnostic.MA0047.severity = warning
# MA0048: File name must match type name (multiple types per file are allowed)
dotnet_diagnostic.MA0048.severity = none
# MA0051: Method is too long
dotnet_diagnostic.MA0051.severity = none
# MA0053: duplicate of CA1852 (the enforced sealing rule)
dotnet_diagnostic.MA0053.severity = none
# MA0057: duplicate of CA1710
dotnet_diagnostic.MA0057.severity = none
# MA0058: duplicate of CA1710
dotnet_diagnostic.MA0058.severity = none
# MA0059: duplicate of CA1710
dotnet_diagnostic.MA0059.severity = none
# MA0062: duplicate of CA2217
dotnet_diagnostic.MA0062.severity = none
# MA0064: keeps the error severity of the disabled MT1000
dotnet_diagnostic.MA0064.severity = error
# MA0069: duplicate of CA2211
dotnet_diagnostic.MA0069.severity = none
# MA0070: duplicate of CA1041
dotnet_diagnostic.MA0070.severity = none
# MA0072: duplicate of CA2219
dotnet_diagnostic.MA0072.severity = none
# MA0078: duplicate of RCS1077
dotnet_diagnostic.MA0078.severity = none
# MA0079: Forward the CancellationToken using .WithCancellation()
dotnet_diagnostic.MA0079.severity = warning
# MA0080: Use a cancellation token using .WithCancellation()
dotnet_diagnostic.MA0080.severity = warning
# MA0082: duplicate of CA2242
dotnet_diagnostic.MA0082.severity = none
# MA0086: duplicate of CA1065
dotnet_diagnostic.MA0086.severity = none
# MA0090: duplicate of RCS1259
dotnet_diagnostic.MA0090.severity = none
# MA0095: duplicate of CA1067
