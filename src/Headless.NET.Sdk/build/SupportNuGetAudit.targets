<Project>
  <!--
    Audit is a mandatory quality policy, but its findings are warnings in every build, CI and AI-agent
    builds included. A finding depends on the advisory database, not on the change being built: an
    advisory published today fails every branch, unrelated pull requests too, until someone patches
    or pins the package. Visibility is the policy; the fix is prioritized like any other security work.

      NU1901 - package with a known low severity vulnerability.
      NU1902 - package with a known moderate severity vulnerability.
      NU1903 - package with a known high severity vulnerability.
      NU1904 - package with a known critical severity vulnerability.
      see: https://learn.microsoft.com/nuget/reference/errors-and-warnings/nu1901-nu1904

    SupportNuGetWarningPolicy.props keeps them out of the CI and AI-agent MSBuild warning escalation.
    A consumer that wants a hard gate lists the codes in its own WarningsAsErrors, which NuGet honors
    ahead of WarningsNotAsErrors.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>
