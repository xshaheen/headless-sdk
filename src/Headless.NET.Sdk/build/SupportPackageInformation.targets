<Project TreatAsLocalProperty="_LicensePath;_PackageReadmeFilePath;_PackageThirdPartyNoticesPath;_SolutionLicense;_ProjectReadme;_SolutionReadme">
  <PropertyGroup
    Label="Package Information"
    Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' "
  >
    <PackageId Condition=" '$(PackageId)' == '' ">$(MSBuildProjectName)</PackageId>
    <Title Condition=" '$(Title)' == '' ">$(MSBuildProjectName)</Title>

    <!--
      Authors / Company are intentionally not defaulted here. Microsoft.NET.Sdk falls back to
      $(AssemblyName); consumers should set their own. The Headless author's repo sets these
      in its own Directory.Build.props (which does not ship) so the SDK's own packages keep
      attribution without leaking the SDK author's name into consumer-built packages.
    -->

    <!-- Optional: Declare that the Repository URL can be published to NuSpec -->
    <PublishRepositoryUrl Condition=" '$(PublishRepositoryUrl)' == '' ">true</PublishRepositoryUrl>
    <RepositoryType Condition=" '$(RepositoryType)' == '' ">git</RepositoryType>
    <!-- Readme -->
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and Exists('$(MSBuildProjectDirectory)/README.md')"
      >$(MSBuildProjectDirectory)/README.md</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and Exists('$(MSBuildProjectDirectory)/readme.md')"
      >$(MSBuildProjectDirectory)/readme.md</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and Exists('$(MSBuildProjectDirectory)/Readme.md')"
      >$(MSBuildProjectDirectory)/Readme.md</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and Exists('$(MSBuildProjectDirectory)/ReadMe.md')"
      >$(MSBuildProjectDirectory)/ReadMe.md</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and '$(SearchReadmeFileAbove)' == 'true' and Exists($([MSBuild]::GetPathOfFileAbove('README.md', '$(MSBuildProjectDirectory)')))"
      >$([MSBuild]::GetPathOfFileAbove('README.md', '$(MSBuildProjectDirectory)'))</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and '$(SearchReadmeFileAbove)' == 'true' and Exists($([MSBuild]::GetPathOfFileAbove('readme.md', '$(MSBuildProjectDirectory)')))"
      >$([MSBuild]::GetPathOfFileAbove('readme.md', '$(MSBuildProjectDirectory)'))</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and '$(SearchReadmeFileAbove)' == 'true' and Exists($([MSBuild]::GetPathOfFileAbove('Readme.md', '$(MSBuildProjectDirectory)')))"
      >$([MSBuild]::GetPathOfFileAbove('Readme.md', '$(MSBuildProjectDirectory)'))</_PackageReadmeFilePath>
    <_PackageReadmeFilePath
      Condition="'$(_PackageReadmeFilePath)' == '' and '$(SearchReadmeFileAbove)' == 'true' and Exists($([MSBuild]::GetPathOfFileAbove('ReadMe.md', '$(MSBuildProjectDirectory)')))"
      >$([MSBuild]::GetPathOfFileAbove('ReadMe.md', '$(MSBuildProjectDirectory)'))</_PackageReadmeFilePath>
    <PackageReadmeFile
      Condition="'$(DisableReadme)' != 'true' and '$(PackageReadmeFile)' == '' and '$(_PackageReadmeFilePath)' != ''"
      >README.md</PackageReadmeFile>

    <!-- Third-party notices -->
    <_PackageThirdPartyNoticesPath
      Condition="'$(_PackageThirdPartyNoticesPath)' == '' and Exists('$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.TXT')"
      >$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.TXT</_PackageThirdPartyNoticesPath>
    <_PackageThirdPartyNoticesPath
      Condition="'$(_PackageThirdPartyNoticesPath)' == '' and Exists('$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.txt')"
      >$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.txt</_PackageThirdPartyNoticesPath>
    <_PackageThirdPartyNoticesPath
      Condition="'$(_PackageThirdPartyNoticesPath)' == '' and Exists('$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.MD')"
      >$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.MD</_PackageThirdPartyNoticesPath>
    <_PackageThirdPartyNoticesPath
      Condition="'$(_PackageThirdPartyNoticesPath)' == '' and Exists('$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.md')"
      >$(MSBuildProjectDirectory)/THIRD-PARTY-NOTICES.md</_PackageThirdPartyNoticesPath>

    <!--
      Logo. HeadlessPackageIconPath names an icon outside the conventional locations, such as a
      repository assets/ folder; $(SolutionDir) is empty when a single project is built, so the
      solution-level fallback alone misses it there.
    -->
    <PackageIcon
      Condition="'$(DisablePackageLogo)' != 'true'
        and '$(PackageIcon)' == ''
        and '$(HeadlessPackageIconPath)' != ''"
      >$([System.IO.Path]::GetFileName('$(HeadlessPackageIconPath)'))</PackageIcon>
    <PackageIcon
      Condition="'$(DisablePackageLogo)' != 'true'
        and '$(PackageIcon)' == ''
        and (Exists('$(ProjectDir)logo.png') or Exists('$(SolutionDir)logo.png'))"
      >logo.png</PackageIcon>
  </PropertyGroup>

  <!--
    Symbols policy. HeadlessSymbolFormat selects how debug symbols ship for non-test projects:

      embedded (default) - DebugType=embedded + IncludeSymbols=false. The PDB travels inside the
                           assembly, so symbols resolve on every feed - including GitHub Packages,
                           which has no symbol server to serve a .snupkg from.
      snupkg             - IncludeSymbols=true + SymbolPackageFormat=snupkg (the previous SDK
                           default). DebugType is left untouched.
      none               - IncludeSymbols=false. DebugType is left untouched.

    embedded and snupkg also default EmbedUntrackedSources=true: sources the repository does not
    track (source-generator output, obj/ generated files) cannot be fetched through SourceLink,
    so they are embedded in the PDB to stay debuggable. 'none' ships no symbols and stays on
    Microsoft defaults.

    Consumer-set DebugType, IncludeSymbols, or SymbolPackageFormat always win via the empty-check
    guards below. Caveat: Microsoft.NET.Sdk.props defaults DebugType=portable during the props
    phase, so by the time this file evaluates, an explicit consumer 'portable' is
    indistinguishable from "not set" and the embedded mode rewrites it; to keep portable PDBs,
    set HeadlessSymbolFormat=none (or snupkg) instead of DebugType=portable.

    BlazorWebAssembly exception: WASM apps ship their assemblies to the browser, and an embedded
    PDB survives into the published _framework payload (the MPDB blob is preserved through webcil
    conversion in a Release publish), leaking debug info and inflating the download. Portable
    PDBs are excluded from the payload, so Blazor WASM projects default to 'none'.
  -->
  <PropertyGroup
    Label="Symbols Policy"
    Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' "
  >
    <HeadlessSymbolFormat
      Condition=" '$(HeadlessSymbolFormat)' == '' and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' "
      >none</HeadlessSymbolFormat>
    <HeadlessSymbolFormat Condition=" '$(HeadlessSymbolFormat)' == '' ">embedded</HeadlessSymbolFormat>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' and '$(HeadlessSymbolFormat)' == 'embedded' ">
    <DebugType Condition=" '$(DebugType)' == '' or '$(DebugType)' == 'portable' ">embedded</DebugType>
    <IncludeSymbols Condition=" '$(IncludeSymbols)' == '' ">false</IncludeSymbols>
    <EmbedUntrackedSources Condition=" '$(EmbedUntrackedSources)' == '' ">true</EmbedUntrackedSources>
    <!--
      Re-derive the loose-PDB bookkeeping. Microsoft.Common.CurrentVersion.targets computes
      _DebugSymbolsProduced from DebugType BEFORE NuGet-imported targets evaluate (DebugType is
      still 'portable' at that point), so build/pack would expect a .pdb an embedded compile
      never writes and `dotnet pack` fails with NU5026. Items evaluate after all properties, so
      correcting the property here is honored by the _DebugSymbolsOutputPath item that feeds
      DebugSymbolsProjectOutputGroup.
    -->
    <_DebugSymbolsProduced Condition=" '$(DebugType)' == 'embedded' ">false</_DebugSymbolsProduced>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' and '$(HeadlessSymbolFormat)' == 'snupkg' ">
    <IncludeSymbols Condition=" '$(IncludeSymbols)' == '' ">true</IncludeSymbols>
    <SymbolPackageFormat Condition=" '$(SymbolPackageFormat)' == '' ">snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources Condition=" '$(EmbedUntrackedSources)' == '' ">true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' and '$(HeadlessSymbolFormat)' == 'none' ">
    <IncludeSymbols Condition=" '$(IncludeSymbols)' == '' ">false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup Label="Package Files" Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' ">
    <!-- License -->
    <_SolutionLicense Include="LICENSE" Condition="Exists('LICENSE')" />
    <_SolutionLicense Include="LICENSE.txt" Condition="@(_SolutionLicense) == '' and Exists('LICENSE.txt')" />
    <_SolutionLicense
      Include="$(SolutionDir)LICENSE"
      Condition="@(_SolutionLicense) == '' and Exists('$(SolutionDir)LICENSE')"
    />
    <_SolutionLicense
      Include="$(SolutionDir)LICENSE.txt"
      Condition="@(_SolutionLicense) == '' and Exists('$(SolutionDir)LICENSE.txt')"
    />
    <_LicensePath
      Include="$([MSBuild]::GetPathOfFileAbove('LICENSE'))"
      Condition="@(_SolutionLicense) == '' and Exists($([MSBuild]::GetPathOfFileAbove('LICENSE')))"
    />
    <_LicensePath
      Include="$([MSBuild]::GetPathOfFileAbove('LICENSE.txt'))"
      Condition="@(_SolutionLicense) == '' and '@(_LicensePath)' == '' and Exists($([MSBuild]::GetPathOfFileAbove('LICENSE.txt')))"
    />
    <None
      Include="@(_SolutionLicense)"
      Pack="true"
      PackagePath=""
      Visible="false"
      Condition="Exists(@(_SolutionLicense))"
    />
    <None Include="@(_LicensePath)" Pack="true" PackagePath="" Visible="false" Condition="Exists(@(_LicensePath))" />
  </ItemGroup>

  <Target
    Name="HeadlessSetPackageLicenseFile"
    BeforeTargets="GenerateNuspec"
    Condition=" '$(IsTestProject)' != 'true'
      and '$(IsTestHarnessProject)' != 'true'
      and '$(PackageLicenseExpression)' == ''
      and '$(PackageLicenseFile)' == '' "
  >
    <PropertyGroup>
      <PackageLicenseFile Condition=" '@(_SolutionLicense)' != '' "
        >@(_SolutionLicense->'%(Filename)%(Extension)')</PackageLicenseFile>
      <PackageLicenseFile Condition=" '$(PackageLicenseFile)' == '' and '@(_LicensePath)' != '' "
        >@(_LicensePath->'%(Filename)%(Extension)')</PackageLicenseFile>
    </PropertyGroup>
  </Target>

  <ItemGroup
    Label="Package Additional Files"
    Condition=" '$(IsTestProject)' != 'true' and '$(IsTestHarnessProject)' != 'true' "
  >
    <!-- Readme -->
    <None
      Include="$(_PackageReadmeFilePath)"
      Pack="true"
      PackagePath="README.md"
      Visible="true"
      Condition="'$(DisableReadme)' != 'true' and '$(_PackageReadmeFilePath)' != ''"
    />

    <!-- Third-party notices -->
    <None
      Include="$(_PackageThirdPartyNoticesPath)"
      Pack="true"
      PackagePath=""
      Visible="false"
      Condition="'$(_PackageThirdPartyNoticesPath)' != ''"
    />

    <!-- Logo -->
    <None
      Include="$(HeadlessPackageIconPath)"
      Pack="true"
      PackagePath=""
      Visible="false"
      Condition="'$(DisablePackageLogo)' != 'true' and '$(HeadlessPackageIconPath)' != ''"
    />
    <_ProjectLogo
      Include="$(ProjectDir)logo.png"
      Condition="'$(HeadlessPackageIconPath)' == '' and Exists('$(ProjectDir)logo.png')"
    />
    <_SolutionLogo
      Include="$(SolutionDir)logo.png"
      Condition="'$(HeadlessPackageIconPath)' == '' and @(_ProjectLogo) == '' and Exists('$(SolutionDir)logo.png')"
    />
    <None
      Include="@(_ProjectLogo)"
      Pack="true"
      PackagePath=""
      Visible="true"
      Condition="'$(DisablePackageLogo)' != 'true' and Exists(@(_ProjectLogo))"
    />
    <None
      Include="@(_SolutionLogo)"
      Pack="true"
      PackagePath=""
      Visible="false"
      Condition="'$(DisablePackageLogo)' != 'true' and !Exists(@(_ProjectLogo)) and Exists(@(_SolutionLogo))"
    />
  </ItemGroup>
</Project>
