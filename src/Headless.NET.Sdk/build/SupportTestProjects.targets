<Project>
  <PropertyGroup>
    <!-- Headless.NET.Sdk.Test is MTP-only; xUnit uses this when generating its entry point. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject Condition="'$(IsTestProject)' == '' AND '$(IsTestHarnessProject)' != 'true'">true</IsTestProject>
    <!--
      A harness is a library that test projects reference, never a test of its own, so it overrides
      earlier defaults the way OutputType does below. The Test SDK's props set IsTestProject=true before
      the project body can declare the harness, and under PackageReference consumption the MTP
      packages' targets set IsTestingPlatformApplication=true before these targets run. Either value
      makes a solution-wide `dotnet test` try to run the harness.
    -->
    <IsTestProject Condition="'$(IsTestHarnessProject)' == 'true'">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(IsTestHarnessProject)' == 'true'">false</IsTestingPlatformApplication>
    <GenerateRuntimeConfigurationFiles
      Condition="'$(GenerateRuntimeConfigurationFiles)' == '' AND '$(IsTestHarnessProject)' == 'true'"
      >true</GenerateRuntimeConfigurationFiles>
    <OutputType Condition="'$(IsTestHarnessProject)' == 'true'">Library</OutputType>
    <IsPublishable Condition="'$(IsPublishable)' == ''">false</IsPublishable>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- Auto-enable code coverage on CI; explicit toggle wins. -->
    <EnableCodeCoverage Condition="'$(EnableCodeCoverage)' == '' AND '$(ContinuousIntegrationBuild)' == 'true'"
      >true</EnableCodeCoverage>
    <!--
      Crash and hang dumps are post-mortem diagnostics for unattended runs. Each extension relaunches
      the test host under a controller process, which adds about 0.2 s to every run. An interactive
      developer can attach a debugger instead, so local runs skip them. CI and AI-agent runs are
      unattended: nobody attaches a debugger, and without a hang dump a hung test holds the run until
      something outside kills it, leaving no evidence. Explicit toggle wins.
    -->
    <EnableTestDumps
      Condition="'$(EnableTestDumps)' == '' AND ('$(ContinuousIntegrationBuild)' == 'true' OR '$(HeadlessIsLlmContext)' == 'true')"
      >true</EnableTestDumps>
    <HeadlessCoverageSettingsPath Condition="'$(HeadlessCoverageSettingsPath)' == ''"
      >$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'configurations', 'default.runsettings'))</HeadlessCoverageSettingsPath>
  </PropertyGroup>

  <!-- The Test SDK owns these exact extension bindings, including direct consumer duplicates. -->
  <ItemGroup Condition="'$(HeadlessSdkProjectType)' == 'Test'">
    <PackageReference Remove="Microsoft.Testing.Extensions.CrashDump;Microsoft.Testing.Extensions.CodeCoverage;Microsoft.Testing.Extensions.HangDump;Microsoft.Testing.Extensions.HotReload;Microsoft.Testing.Extensions.Retry;Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference
      Include="Microsoft.Testing.Extensions.CrashDump"
      Version="$(_HeadlessMtpCrashDumpVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.CodeCoverage"
      Version="$(_HeadlessMtpCodeCoverageVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.HangDump"
      Version="$(_HeadlessMtpHangDumpVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.HotReload"
      Version="$(_HeadlessMtpHotReloadVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.Retry"
      Version="$(_HeadlessMtpRetryVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.TrxReport"
      Version="$(_HeadlessMtpTrxReportVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="all"
      ExcludeAssets=""
    />
  </ItemGroup>

  <!--
    The coverage package ships about 43 MB of native profilers for six runtimes, and a RID-agnostic
    build copies all of them into every test project's output. The reference stays unconditional,
    because a coverage-only reference would change the restore graph and break the consumer's locked
    restore (NU1004) on CI. Only the copy is skipped, so builds that do not collect coverage leave the
    natives out of bin and out of deps.json. Builds that collect coverage keep them. Windows build hosts
    keep them too: coverage on Linux and macOS was measured to instrument statically and load none of
    them, while Windows coverage may load the profilers when coverage is requested at run time.
  -->
  <Target
    Name="_HeadlessExcludeCodeCoverageNativeAssets"
    AfterTargets="ResolvePackageAssets"
    Condition="'$(HeadlessSdkProjectType)' == 'Test' AND '$(EnableCodeCoverage)' != 'true' AND !$([MSBuild]::IsOSPlatform('Windows'))"
  >
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems
        Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.Testing.Extensions.CodeCoverage'"
      />
      <NativeCopyLocalItems
        Remove="@(NativeCopyLocalItems)"
        Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Testing.Extensions.CodeCoverage'"
      />
    </ItemGroup>
  </Target>

  <!--
    Most CI pipelines run `dotnet build` and `dotnet test` separately. Avoid repeating analyzer
    work in MTP's test-build phase unless the consumer explicitly opts out of this optimization.
  -->
  <Target Name="DisableAnalyzersWhenRunningTests" BeforeTargets="_MTPBuild" Condition="'$(OptimizeTestRun)' != 'false'">
    <PropertyGroup>
      <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>
  </Target>

  <!--
    Default Microsoft Testing Platform (MTP) arguments.

    These MUST be set in a static PropertyGroup, not a BeforeTargets="_MTPBuild" target.
    The new "dotnet test" experience (global.json "runner": "Microsoft.Testing.Platform")
    reads TestingPlatformCommandLineArguments during project evaluation and does NOT run the
    legacy _MTPBuild target, so a target-based assignment never takes effect (the args get
    silently dropped: no coverage, TRX, or dumps). Coverage settings use MTP's
    "coverage-settings" runner flag.
  -->
  <PropertyGroup>
    <MinimumExpectedTests Condition="'$(MinimumExpectedTests)' == ''">1</MinimumExpectedTests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDefaultTestSettings)' != 'false'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --report-trx</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(EnableCodeCoverage)' == 'true'"
      >$(TestingPlatformCommandLineArguments) --coverage</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(EnableCodeCoverage)' == 'true'"
      >$(TestingPlatformCommandLineArguments) --coverage-settings &quot;$(HeadlessCoverageSettingsPath)&quot;</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(EnableTestDumps)' == 'true'"
      >$(TestingPlatformCommandLineArguments) --crashdump --crashdump-type mini</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(EnableTestDumps)' == 'true'"
      >$(TestingPlatformCommandLineArguments) --hangdump --hangdump-timeout 10m --hangdump-type mini</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments
      Condition="'$(MinimumExpectedTests)' != '' AND '$(MinimumExpectedTests)' != '0'"
      >$(TestingPlatformCommandLineArguments) --minimum-expected-tests $(MinimumExpectedTests)</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!--
    xUnit v3 4.0.1+ wraps its generated entry point and AOT source in #pragma warning disable when
    XUNIT_GENERATED_DISABLE_WARNINGS is defined, so analyzer warnings in code the consumer does not own
    cannot fail a warnings-as-errors build. Earlier xUnit releases ignore the constant.
    PackageReference is an item list, so conditional constant configuration must run in a target.
  -->
  <PropertyGroup>
    <_HeadlessXunitEntryPointDisableWarningsTarget>_HeadlessConfigureXunitEntryPointDisableWarnings</_HeadlessXunitEntryPointDisableWarningsTarget>
  </PropertyGroup>

  <Target
    Name="_HeadlessConfigureXunitEntryPointDisableWarnings"
    BeforeTargets="CoreCompile"
    Condition="'$(EnableXunitEntryPointDisableWarnings)' != 'false' AND (
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v1')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-off')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.core')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-v2')) == 'true' OR
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.core.mtp-off')) == 'true')"
  >
    <PropertyGroup>
      <EnableXunitEntryPointDisableWarnings Condition="'$(EnableXunitEntryPointDisableWarnings)' == ''"
        >true</EnableXunitEntryPointDisableWarnings>
      <_HeadlessXunitEntryPointDisableWarningsAlreadyDefined Condition="'$(MSBuildProjectExtension)' == '.vbproj'"
        >$([System.String]::Copy(',$(DefineConstants),').Contains(',XUNIT_GENERATED_DISABLE_WARNINGS=-1,'))</_HeadlessXunitEntryPointDisableWarningsAlreadyDefined>
      <_HeadlessXunitEntryPointDisableWarningsAlreadyDefined Condition="'$(MSBuildProjectExtension)' != '.vbproj'"
        >$([System.String]::Copy(';$(DefineConstants);').Contains(';XUNIT_GENERATED_DISABLE_WARNINGS;'))</_HeadlessXunitEntryPointDisableWarningsAlreadyDefined>
      <DefineConstants
        Condition="'$(_HeadlessXunitEntryPointDisableWarningsAlreadyDefined)' != 'true' AND '$(MSBuildProjectExtension)' == '.vbproj'"
        >$(DefineConstants),XUNIT_GENERATED_DISABLE_WARNINGS=-1</DefineConstants>
      <DefineConstants
        Condition="'$(_HeadlessXunitEntryPointDisableWarningsAlreadyDefined)' != 'true' AND '$(MSBuildProjectExtension)' != '.vbproj'"
        >$(DefineConstants);XUNIT_GENERATED_DISABLE_WARNINGS</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- xUnit MTP implicit using. The test framework remains consumer-selected. -->
  <ItemGroup
    Condition="'$(ImplicitUsings)' == 'enable' AND
      @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) == 'true'"
  >
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
