<Project>
  <!--
    Wires the shipped BannedSymbols.txt files into BannedApiAnalyzers as AdditionalFiles.
    Consumers can disable the complete policy or any list independently.
  -->
  <ItemGroup>
    <AdditionalFiles
      Include="$(MSBuildThisFileDirectory)..\configurations\BannedSymbols.txt"
      Condition="'$(IncludeDefaultBannedSymbols)' != 'false'"
      Visible="false"
    />
    <AdditionalFiles
      Include="$(MSBuildThisFileDirectory)..\configurations\BannedSymbols.NewtonsoftJson.txt"
      Condition="'$(BannedNewtonsoftJsonSymbols)' != 'false'"
      Visible="false"
    />
    <AdditionalFiles
      Include="$(MSBuildThisFileDirectory)..\configurations\BannedSymbols.GuardClauses.txt"
      Condition="'$(BannedGuardClauseSymbols)' != 'false'"
      Visible="false"
    />
    <!--
      Sleeps, Task.Delay, Stopwatch, and clock reads make a test slow on a fast machine and flaky on
      a slow one. The list is opt-in because existing suites hold many of them and RS0030 fails a CI
      build; a later release turns it on by default. Test harness projects hold shared fixtures that
      tests wait through, so they follow the same rule.
    -->
    <AdditionalFiles
      Include="$(MSBuildThisFileDirectory)..\configurations\BannedSymbols.TestTiming.txt"
      Condition="'$(BannedTestTimingSymbols)' == 'true' and ('$(IsTestProject)' == 'true' or '$(IsTestHarnessProject)' == 'true')"
      Visible="false"
    />
    <!-- CA1510-CA1513 recommend the helpers this list bans; silence them only while it is active. -->
    <EditorConfigFiles Remove="$(MSBuildThisFileDirectory)..\configurations\Headless.NET.Sdk.GuardClauses.editorconfig" />
    <EditorConfigFiles
      Include="$(MSBuildThisFileDirectory)..\configurations\Headless.NET.Sdk.GuardClauses.editorconfig"
      Condition="'$(BannedGuardClauseSymbols)' != 'false'"
    />
  </ItemGroup>
</Project>
