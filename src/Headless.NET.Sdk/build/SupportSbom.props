<Project>
  <!--
    MSBuild SDK package dependencies are resolved for SDK discovery but do not become consumer
    project dependencies. Add the SBOM tool explicitly so it is restored in every SDK consumption
    mode. Headless owns the targets import, so NuGet build assets are excluded to prevent a second
    import through the generated NuGet targets file.
  -->
  <PropertyGroup>
    <_HeadlessMicrosoftSbomTargetsVersion>[4.1.13]</_HeadlessMicrosoftSbomTargetsVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsBuildTaskProject)' != 'true'">
    <!--
      GeneratePathProperty makes restore emit $(PkgMicrosoft_Sbom_Targets) with the RESOLVED
      package location. A NuGetPackageRoot-based guess breaks whenever the package is satisfied
      from a NuGet fallback folder or shared cache, where nothing is copied into the local
      packages folder.
    -->
    <PackageReference
      Include="Microsoft.Sbom.Targets"
      Version="$(_HeadlessMicrosoftSbomTargetsVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="none"
      GeneratePathProperty="true"
    />
  </ItemGroup>
</Project>
