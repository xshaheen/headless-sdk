<Project>
  <PropertyGroup Label="Set Repo Defaults">
    <HeadlessSdkName Condition="'$(HeadlessSdkName)' == ''">Headless.NET.Sdk</HeadlessSdkName>
    <HeadlessSdkProjectType Condition="'$(HeadlessSdkProjectType)' == ''">Default</HeadlessSdkProjectType>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <PlatformName Condition="'$(PlatformName)' == ''">$(Platform)</PlatformName>
    <HeadlessEnforceConfigureAwait Condition="'$(HeadlessEnforceConfigureAwait)' == ''"
      >false</HeadlessEnforceConfigureAwait>
  </PropertyGroup>

  <PropertyGroup Label="Project Categorisation">
    <!--
      Test classification is explicit. Consumers signal a test project via either:
        (1) <Project Sdk="Headless.NET.Sdk.Test"> sets IsTestProject=true automatically.
        (2) <IsTestProject>true</IsTestProject> in the csproj or Directory.Build.props.
        (3) <IsTestHarnessProject>true</IsTestHarnessProject> for shared harness libraries that
            should get test defaults without executing as test hosts.
    -->
    <IsTestHarnessProject Condition=" '$(IsTestHarnessProject)' == '' ">false</IsTestHarnessProject>
  </PropertyGroup>

  <PropertyGroup Label="General Configurations">
    <RootNamespace Condition="'$(RootNamespace)' == ''">$(MSBuildProjectName)</RootNamespace>
    <AssemblyName Condition="'$(AssemblyName)' == ''">$(MSBuildProjectName)</AssemblyName>

    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.lscache</DefaultItemExcludes>

    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>

    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>

    <!--
      Advisory defaults: guarded so a consumer Directory.Build.props value wins in BOTH
      consumption modes. Under MSBuild SDK consumption this file evaluates before
      Directory.Build.props (last write would win anyway); under PackageReference consumption it
      evaluates after, where an unconditional assignment would silently override the consumer.
    -->
    <WarningLevel Condition="'$(WarningLevel)' == ''">9999</WarningLevel>
    <Features Condition="'$(Features)' == ''">strict</Features>
    <!--
      ReportAnalyzer is analyzer profiling, not a correctness feature: it makes the compiler time
      every analyzer callback and print a per-analyzer table, on every build. Its default lives in
      SupportGeneral.targets so a consumer ContinuousIntegrationBuild set in Directory.Build.props
      or the project body also activates it - under MSBuild SDK consumption this .props file
      evaluates before both. Profile a local build with `-p:ReportAnalyzer=true`.
    -->
    <SuppressNETCoreSdkPreviewMessage Condition="'$(SuppressNETCoreSdkPreviewMessage)' == ''"
      >false</SuppressNETCoreSdkPreviewMessage>
    <CheckEolTargetFramework Condition="'$(CheckEolTargetFramework)' == ''">true</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings Condition="'$(SuppressTfmSupportBuildWarnings)' == ''"
      >false</SuppressTfmSupportBuildWarnings>

    <!--
      Mandatory quality baseline: unconditional here AND re-asserted after the consumer project
      body (SupportGeneral.targets / SupportMandatoryAnalyzers.targets), so both consumption modes
      behave identically. EffectiveAnalysisLevel is computed in Microsoft.NET.Sdk.Analyzers.targets,
      which evaluates after the Headless targets re-assert, so the re-assert is authoritative.
    -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(CodeAnalysisTreatWarningsAsErrors)' == ''"
      >false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Inner-loop choices, not policy: a local build may skip analyzers during build or live
      analysis. Guarded so a consumer value wins under PackageReference consumption, where this
      file evaluates after Directory.Build.props. SupportMandatoryAnalyzers.targets forces both
      back on for CI and AI-agent builds, which are where the quality gate is enforced.
    -->
    <RunAnalyzersDuringBuild Condition="'$(RunAnalyzersDuringBuild)' == ''">true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(RunAnalyzersDuringLiveAnalysis)' == ''"
      >true</RunAnalyzersDuringLiveAnalysis>
    <_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>

    <AccelerateBuildsInVisualStudio Condition="'$(AccelerateBuildsInVisualStudio)' == ''"
      >true</AccelerateBuildsInVisualStudio>

    <!-- Determinism is part of the mandatory quality baseline. -->
    <Deterministic>true</Deterministic>

    <!-- Faster + more correct restore. -->
    <RestoreUseStaticGraphEvaluation Condition="'$(RestoreUseStaticGraphEvaluation)' == ''"
      >true</RestoreUseStaticGraphEvaluation>
    <RestoreSerializeGlobalProperties Condition="'$(RestoreSerializeGlobalProperties)' == ''"
      >true</RestoreSerializeGlobalProperties>

    <!-- Run the Microsoft package-validation checks for packable projects by default. -->
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup
    Label="CI Quality Gate"
    Condition=" '$(_HeadlessIsKnownCiEnvironment)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true' "
  >
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NETSDK1138;$(_HeadlessNuGetWarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="NoWarn">
    <!--
      $(NoWarn) is reserved for diagnostics that analyzer config cannot express: /nowarn wins over
      every editorconfig severity and a consumer cannot re-enable a NoWarn'd rule per project.
      Analyzer-rule disables live in Headless.NET.Sdk.Analyzers.editorconfig (severity = none) so a
      consumer .editorconfig can re-enable any of them.
      CS1712: Type parameter has no matching typeparam tag in the XML comment (compiler; paired
        with the CS1573/CS1591 handling in SupportGeneral.targets).
      NU5104: A stable release of a package should not have a prerelease dependency (NuGet pack).
    -->
    <NoWarn>$(NoWarn);1712;NU5104</NoWarn>
    <!--
      The IsAspireHost conditional NoWarn lives in SupportGeneral.targets, NOT here: that property
      can be set by the consumer in Directory.Build.props or the csproj, which under MSBuild SDK
      consumption load AFTER this .props file (build/Headless.NET.Sdk.props is wired via
      CustomBeforeDirectoryBuildProps, i.e. before Directory.Build.props). Test-project analyzer
      relaxations live in Headless.NET.Sdk.Tests.editorconfig.
    -->
  </PropertyGroup>

  <PropertyGroup Label="Language Configuration">
    <NeutralLanguage Condition="'$(NeutralLanguage)' == ''">en</NeutralLanguage>
    <PreferredUILang Condition="'$(PreferredUILang)' == ''">en</PreferredUILang>
  </PropertyGroup>
</Project>
