<Project>
  <!-- The named Headless quality baseline is authoritative after the consumer project body. -->
  <PropertyGroup Condition="'$(IsBuildTaskProject)' != 'true'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Analyzers cost roughly 40% of compile time, so a local inner loop may set
    RunAnalyzersDuringBuild=false (keep live analysis in the editor) or
    RunAnalyzersDuringLiveAnalysis=false (keep build analysis). Roslyn reads those two only while
    RunAnalyzers is empty (Microsoft.Managed.Core.targets, _SkipAnalyzers), so a local build clears
    RunAnalyzers: a consumer RunAnalyzers=false still cannot turn analysis off wholesale.
  -->
  <PropertyGroup Condition="'$(IsBuildTaskProject)' != 'true'">
    <RunAnalyzers></RunAnalyzers>
    <RunAnalyzersDuringBuild Condition="'$(RunAnalyzersDuringBuild)' == ''">true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(RunAnalyzersDuringLiveAnalysis)' == ''"
      >true</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <!--
    CI and AI-agent builds are where the warning gate is enforced, so they always run analyzers;
    an agent ignoring a consumer opt-out is what keeps its session from leaving findings for CI.
  -->
  <PropertyGroup
    Condition=" '$(IsBuildTaskProject)' != 'true'
      and ('$(_HeadlessIsKnownCiEnvironment)' == 'true'
        or '$(ContinuousIntegrationBuild)' == 'true'
        or '$(HeadlessIsLlmContext)' == 'true') "
  >
    <RunAnalyzers>true</RunAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <!--
    A consumer-authored reference with the same package ID replaces an implicit SDK reference.
    Reassert the binding metadata so ordinary PackageReference overrides cannot disable or leak
    the required analyzers.
  -->
  <ItemGroup Condition="'$(IsBuildTaskProject)' != 'true'">
    <PackageReference Remove="Meziantou.Analyzer;Microsoft.CodeAnalysis.BannedApiAnalyzers;AsyncFixer;Microsoft.VisualStudio.Threading.Analyzers;SmartAnalyzers.MultithreadingAnalyzer;Roslynator.Analyzers;Roslynator.Formatting.Analyzers;ReflectionAnalyzers;ErrorProne.NET.CoreAnalyzers" />
    <PackageReference
      Include="Meziantou.Analyzer"
      Condition="'$(PackageId)' != 'Meziantou.Analyzer'"
      Version="$(_HeadlessMeziantouAnalyzerVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
      Version="$(_HeadlessBannedApiAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="AsyncFixer"
      Version="$(_HeadlessAsyncFixerVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Microsoft.VisualStudio.Threading.Analyzers"
      Version="$(_HeadlessVisualStudioThreadingAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="SmartAnalyzers.MultithreadingAnalyzer"
      Version="$(_HeadlessMultithreadingAnalyzerVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Roslynator.Analyzers"
      Version="$(_HeadlessRoslynatorAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="Roslynator.Formatting.Analyzers"
      Version="$(_HeadlessRoslynatorFormattingAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="ReflectionAnalyzers"
      Version="$(_HeadlessReflectionAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
    <PackageReference
      Include="ErrorProne.NET.CoreAnalyzers"
      Version="$(_HeadlessErrorProneAnalyzersVersion)"
      IsImplicitlyDefined="true"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
      ExcludeAssets=""
    />
  </ItemGroup>

  <!-- Remove and re-add authoritative editorconfigs exactly once after consumer item evaluation. -->
  <ItemGroup Condition="'$(IsBuildTaskProject)' != 'true'">
    <EditorConfigFiles Remove="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.Analyzers.editorconfig" />
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.Analyzers.editorconfig" />

    <EditorConfigFiles Remove="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.EnforceConfigureAwait.editorconfig" />
    <EditorConfigFiles
      Include="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.EnforceConfigureAwait.editorconfig"
      Condition="'$(HeadlessEnforceConfigureAwait)' == 'true'"
    />

    <EditorConfigFiles Remove="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.SingleFileApp.editorconfig" />
    <EditorConfigFiles
      Include="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.SingleFileApp.editorconfig"
      Condition="'$(FileBasedProgram)' == 'true'"
    />

    <EditorConfigFiles Remove="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.Tests.editorconfig" />
    <EditorConfigFiles
      Include="$(MSBuildThisFileDirectory)../configurations/Headless.NET.Sdk.Tests.editorconfig"
      Condition="'$(IsTestProject)' == 'true' or '$(IsTestHarnessProject)' == 'true'"
    />

    <!-- VSTHRD103 exclusions for Microsoft.VisualStudio.Threading.Analyzers, which is mandatory. -->
    <AdditionalFiles Remove="$(MSBuildThisFileDirectory)../configurations/vs-threading.SyncMethodsToExcludeFromVSTHRD103.Headless.txt" />
    <AdditionalFiles
      Include="$(MSBuildThisFileDirectory)../configurations/vs-threading.SyncMethodsToExcludeFromVSTHRD103.Headless.txt"
      Visible="false"
    />
  </ItemGroup>
</Project>
