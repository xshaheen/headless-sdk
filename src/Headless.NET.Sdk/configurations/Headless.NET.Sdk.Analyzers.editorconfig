is_global = true
global_level = 0

# Headless.NET.Sdk analyzer baseline, injected into every consuming project
# (build/SupportAnalyzerEditorConfigs.props, re-asserted in SupportMandatoryAnalyzers.targets).
#
# Precedence, highest first: a consumer .editorconfig, the global_level 1 overlays (Tests,
# EnforceConfigureAwait, GuardClauses, SingleFileApp), then this file. A consumer re-enables or
# changes any rule with a dotnet_diagnostic.<ID>.severity line in its own .editorconfig. $(NoWarn)
# is reserved for compiler and NuGet diagnostics that analyzer config cannot express.
#
# Layout: one section per analyzer family, rules sorted by ID; rules that share one decision stay
# together under the lowest ID. Each defect class is reported by one rule, so a `none` entry's
# comment names the rule that replaces it or why it is off. Global analyzer configs cannot hold
# [section] headers, so path-scoped settings belong in a consumer .editorconfig.

############################################################
# .NET code quality (CA)
# AnalysisMode=All enables every CA rule as a warning; entries change that default.
############################################################

# CA1000: Do not declare static members on generic types
dotnet_diagnostic.CA1000.severity = suggestion
# CA1002: Do not expose generic lists (performance preference)
dotnet_diagnostic.CA1002.severity = none
# CA1008: Enums should have zero value
dotnet_diagnostic.CA1008.severity = suggestion
# CA1012: duplicate of MA0017, which also covers internal constructors
dotnet_diagnostic.CA1012.severity = none
# CA1019: Define accessors for attribute arguments
dotnet_diagnostic.CA1019.severity = suggestion
# CA1024: Use properties where appropriate
dotnet_diagnostic.CA1024.severity = suggestion
# CA1027: Mark enums with FlagsAttribute
dotnet_diagnostic.CA1027.severity = none
# CA1028: Enum Storage should be Int32
dotnet_diagnostic.CA1028.severity = suggestion
# CA1031: Do not catch general exception types
dotnet_diagnostic.CA1031.severity = none
# CA1032/RCS1194: Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = none
# CA1034: Nested types should not be visible
dotnet_diagnostic.CA1034.severity = none
# CA1036: A class that implements IComparable<T> or IComparable should override comparison operators
dotnet_diagnostic.CA1036.severity = suggestion
# CA1040: Avoid empty interfaces
dotnet_diagnostic.CA1040.severity = none
# CA1045: Do not pass types by reference
dotnet_diagnostic.CA1045.severity = suggestion
# CA1050: duplicate of MA0047, which also reports internal types outside a namespace
dotnet_diagnostic.CA1050.severity = none
# CA1054/CA1055/CA1056/CA2234: URI values should be System.Uri instead of strings
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA2234.severity = none
# CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = none
# CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = suggestion
# CA1304: Specify CultureInfo (duplicate of MA0011, which has a code fix)
dotnet_diagnostic.CA1304.severity = none
# CA1305: Specify IFormatProvider (duplicate of MA0011, which has a code fix)
dotnet_diagnostic.CA1305.severity = none
# CA1307: Specify StringComparison for clarity (duplicate of MA0001, which has a code fix)
dotnet_diagnostic.CA1307.severity = none
# CA1308: Normalize strings to uppercase
dotnet_diagnostic.CA1308.severity = none
# CA1309: Use ordinal StringComparison (duplicate of MA0001, which has a code fix)
dotnet_diagnostic.CA1309.severity = none
# CA1310: Specify StringComparison for correctness (duplicate of MA0074, which has a code fix)
dotnet_diagnostic.CA1310.severity = none
#
# CA1311: duplicate of MA0011 which has a code fix
dotnet_diagnostic.CA1311.severity = none
# CA1508: Avoid dead conditional code
# Flow analysis with frequent false positives on defensive checks, and one of the costliest CA
# rules to run.
dotnet_diagnostic.CA1508.severity = none
# CA1515: Consider making public types internal
dotnet_diagnostic.CA1515.severity = none
# CA1711: Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1711.severity = none
# CA1716: Identifiers should not match keywords
dotnet_diagnostic.CA1716.severity = none
# CA1720: Identifiers should not contain type names
dotnet_diagnostic.CA1720.severity = suggestion
# CA1724: Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = none
# CA1725: Parameter names should match base declaration
dotnet_diagnostic.CA1725.severity = suggestion
# CA1805: Do not initialize unnecessarily.
dotnet_diagnostic.CA1805.severity = suggestion
# CA1812: Avoid uninstantiated internal classes (DI-resolved types are invisible to the analyzer)
dotnet_diagnostic.CA1812.severity = none
# CA1819: Properties should not return arrays (performance preference)
dotnet_diagnostic.CA1819.severity = none
# CA1823: Avoid unused private fields
dotnet_diagnostic.CA1823.severity = suggestion
# CA1831|CA1832|CA1833: Use AsSpan or AsMemory instead of Range-based indexers when appropriate
dotnet_diagnostic.CA1831.severity = warning
# CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = silent
# CA1851: Possible multiple enumerations of 'IEnumerable' collection
dotnet_diagnostic.CA1851.severity = suggestion
# CA1859: Use concrete types when possible for improved performance
dotnet_diagnostic.CA1859.severity = suggestion
# CA1861: Avoid constant arrays as arguments
dotnet_diagnostic.CA1861.severity = suggestion
# CA1863: Cache a 'CompositeFormat' for repeated use in this formatting operation
dotnet_diagnostic.CA1863.severity = suggestion
# CA2002: keeps the error severity of the disabled MT1001/MT1002
dotnet_diagnostic.CA2002.severity = error
# CA2007: Consider calling ConfigureAwait — none by default (most Headless apps run without a
# SynchronizationContext); HeadlessEnforceConfigureAwait=true applies the EnforceConfigureAwait
# overlay (global_level 1), which raises this to warning.
dotnet_diagnostic.CA2007.severity = none
# CA2208: duplicate of MA0015, which reports more cases
dotnet_diagnostic.CA2208.severity = none
# CA2214: duplicate of MA0056, which also covers virtual properties and inherited members
dotnet_diagnostic.CA2214.severity = none
# CA2227: Collection properties should be read only
dotnet_diagnostic.CA2227.severity = silent
# CA5359: keeps the error severity of the disabled MA0039
dotnet_diagnostic.CA5359.severity = error
# CA5394: Do not use insecure randomness
dotnet_diagnostic.CA5394.severity = suggestion

############################################################
# .NET code style (IDE)
# Most IDE rules take their severity from the code-style options further down.
############################################################

# IDE0010/IDE0072: Add missing cases to switch statement/expression
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none
# IDE0055: Fix formatting (we use CSharpier)
dotnet_diagnostic.IDE0055.severity = none
# IDE0330: duplicate of MA0158
dotnet_diagnostic.IDE0330.severity = none

