############################################################
# Roslynator.Formatting.Analyzers (RCS0xxx)
# CSharpier owns layout. Only structural blank-line rules that CSharpier preserves stay on.
############################################################

# CSharpier owns wrapping, indentation, braces, and accessor layout.
# Roslynator.Formatting.Analyzers adds structural blank lines that CSharpier preserves.
roslynator_max_line_length = 120
# RCS0001/RCS0008: Separate statements at embedded-statement and block boundaries
dotnet_diagnostic.RCS0001.severity = suggestion
dotnet_diagnostic.RCS0008.severity = suggestion
# RCS0002/RCS0005: Separate region contents from region directives
dotnet_diagnostic.RCS0002.severity = suggestion
dotnet_diagnostic.RCS0005.severity = suggestion
# RCS0003/RCS0006: Separate using directive lists from surrounding content
dotnet_diagnostic.RCS0003.severity = suggestion
dotnet_diagnostic.RCS0006.severity = suggestion
# RCS0009/RCS0010: Separate declarations and documentation
dotnet_diagnostic.RCS0009.severity = suggestion
dotnet_diagnostic.RCS0010.severity = suggestion
# RCS0012: Add blank line between single-line declarations
# Grouping consecutive single-line declarations, such as a block of readonly fields, is idiomatic C#.
dotnet_diagnostic.RCS0012.severity = none
# RCS0045: Use line feed as newline
dotnet_diagnostic.RCS0045.severity = suggestion
# RCS0046: Use spaces instead of tabs (CSharpier owns indentation and trailing whitespace)
dotnet_diagnostic.RCS0046.severity = none
# RCS0056: A line is too long
# CSharpier owns line width; what it cannot wrap is literals and inline suppression reasons.
dotnet_diagnostic.RCS0056.severity = none
# RCS0057/RCS0058: Normalize whitespace at file boundaries
dotnet_diagnostic.RCS0057.severity = suggestion
dotnet_diagnostic.RCS0058.severity = suggestion

############################################################
# Microsoft.VisualStudio.Threading.Analyzers (VSTHRD)
############################################################

# VSTHRD001: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD001.severity = none
# VSTHRD002: Avoid problematic synchronous waits. Replaces Asyncify, which cost 11% of analyzer
# time, and also reports .Wait() and GetAwaiter().GetResult(). A suggestion, not a warning: most
# sync waits are deliberate bridges (sync Dispose, sync interface adapters), and the rule also
# reports .Result reads guarded by IsCompletedSuccessfully.
dotnet_diagnostic.VSTHRD002.severity = suggestion
# VSTHRD003: Avoid awaiting foreign Tasks
# The deadlock it guards against needs JoinableTaskFactory main-thread affinity, which only
# Visual Studio-style apps have.
dotnet_diagnostic.VSTHRD003.severity = none
# VSTHRD004: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD004.severity = none
# VSTHRD010: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD010.severity = none
# VSTHRD011: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD011.severity = none
# VSTHRD012: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD012.severity = none
# VSTHRD100: Avoid async void methods
dotnet_diagnostic.VSTHRD100.severity = warning
# VSTHRD101: Avoid unsupported async delegates
dotnet_diagnostic.VSTHRD101.severity = warning
# VSTHRD102: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD102.severity = none
# VSTHRD103: duplicate of CA1849, which reports a superset of blocking calls in async code
dotnet_diagnostic.VSTHRD103.severity = none
# VSTHRD104: Visual Studio JoinableTaskFactory-oriented; VSTHRD002 reports the same synchronous waits
dotnet_diagnostic.VSTHRD104.severity = none
# VSTHRD105: duplicate of CA2008
dotnet_diagnostic.VSTHRD105.severity = none
# VSTHRD106: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD106.severity = none
# VSTHRD107: Await Task within using expression
dotnet_diagnostic.VSTHRD107.severity = warning
# VSTHRD108: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD108.severity = none
# VSTHRD109: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD109.severity = none
# VSTHRD110: duplicate of MA0134, which costs a tenth as much
dotnet_diagnostic.VSTHRD110.severity = none
# RCS1090/MA0004/VSTHRD111: Use .ConfigureAwait — CA2007 is the single source of truth
dotnet_diagnostic.VSTHRD111.severity = none
# VSTHRD112: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD112.severity = none
# VSTHRD113: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD113.severity = none
# VSTHRD114: duplicate of MA0022
dotnet_diagnostic.VSTHRD114.severity = none
# VSTHRD115: Visual Studio/JoinableTaskFactory-only; no-op cost elsewhere
dotnet_diagnostic.VSTHRD115.severity = none
# RCS1046/VSTHRD200: Asynchronous method name should end with 'Async'
dotnet_diagnostic.VSTHRD200.severity = none

