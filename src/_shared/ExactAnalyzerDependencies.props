<Project>
  <!--
    PackageReference consumers discover build assets only after NuGet has selected this package's
    dependencies. Exact nuspec ranges keep Central Package Management from replacing the mandatory
    analyzer baseline before Headless can reassert its implicit references during evaluation.
  -->
  <ItemGroup>
    <!--
      Directory.Packages.props carries the analyzer pins so the Dependabot anchor project keeps
      them fresh, but this repository's own SDK projects reference the analyzers implicitly and
      NU1009 rejects a central pin for implicitly-defined references (the same guard consumers
      get). Removing the central items here keeps the pins Dependabot-visible without tripping
      the guard; VersionConsistencyTests keeps both sources synchronized.
    -->
    <PackageVersion Remove="Meziantou.Analyzer" />
    <PackageVersion Remove="Microsoft.CodeAnalysis.BannedApiAnalyzers" />
    <PackageVersion Remove="AsyncFixer" />
    <PackageVersion Remove="Microsoft.VisualStudio.Threading.Analyzers" />
    <PackageVersion Remove="SmartAnalyzers.MultithreadingAnalyzer" />
    <PackageVersion Remove="Roslynator.Analyzers" />
    <PackageVersion Remove="Roslynator.Formatting.Analyzers" />
    <PackageVersion Remove="ReflectionAnalyzers" />
    <PackageVersion Remove="ErrorProne.NET.CoreAnalyzers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Update="Meziantou.Analyzer"
      VersionOverride="[$(_HeadlessMeziantouAnalyzerVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="Microsoft.CodeAnalysis.BannedApiAnalyzers"
      VersionOverride="[$(_HeadlessBannedApiAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="AsyncFixer"
      VersionOverride="[$(_HeadlessAsyncFixerVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="Microsoft.VisualStudio.Threading.Analyzers"
      VersionOverride="[$(_HeadlessVisualStudioThreadingAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="SmartAnalyzers.MultithreadingAnalyzer"
      VersionOverride="[$(_HeadlessMultithreadingAnalyzerVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="Roslynator.Analyzers"
      VersionOverride="[$(_HeadlessRoslynatorAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="Roslynator.Formatting.Analyzers"
      VersionOverride="[$(_HeadlessRoslynatorFormattingAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="ReflectionAnalyzers"
      VersionOverride="[$(_HeadlessReflectionAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
    <PackageReference
      Update="ErrorProne.NET.CoreAnalyzers"
      VersionOverride="[$(_HeadlessErrorProneAnalyzersVersion)]"
      PrivateAssets="none"
      IncludeAssets="all"
    />
  </ItemGroup>
</Project>
