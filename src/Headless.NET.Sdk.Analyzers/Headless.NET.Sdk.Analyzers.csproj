<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Headless analyzers ship inside every SDK package (see the nuspecs in src/_shared), not as a
    package of their own, so this project is never packed. The compiler loads the assembly into its
    own process: netstandard2.0 and a Roslyn reference no newer than the oldest compiler that must
    load it are both load requirements, not preferences.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Headless.NET.Sdk.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      4.14 is the Roslyn of the .NET 9.0.3xx SDK and Visual Studio 17.14; an analyzer compiled
      against a newer Roslyn fails to load (CS8032) in any older compiler or IDE. VersionOverride
      with no central PackageVersion: a central pin would transitively pin the test project's
      Roslyn to 4.14 too, below the exact 5.x that its Microsoft.CodeAnalysis.CSharp.Workspaces
      requires. PrivateAssets keeps this floor from flowing to referencing projects.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
