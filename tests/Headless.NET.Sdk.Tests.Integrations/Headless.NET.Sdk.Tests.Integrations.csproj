<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep TargetFrameworks (rather than TargetFramework): CSharpier.MSBuild's inner format build
    expects it. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- xUnit v3 + Microsoft Testing Platform test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!--
      Test-project allowances. This project consumes the plain Microsoft.NET.Sdk (so the Headless
      SDK's IsTestProject NoWarn set does not apply): the repo test convention
      should_{action}_{expected}_when_{condition} uses underscores (CA1707), and the integration
      harness deliberately accepts test-only analyzer noise (CA1849, MA0042, MA0166, CA1861,
      CA1859, CA1720).
    -->
    <NoWarn>$(NoWarn);CA1707;CA1849;MA0042;MA0166;CA1861;CA1859;CA1720</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      xunit.v3.mtp-v2 drives the Microsoft Testing Platform path of this very SDK's
      SupportTestProjects.targets (identity-gated detection) so the test project dogfoods
      the feature it ships. xunit.v3 build props set OutputType=Exe automatically.
    -->
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- This plain Microsoft.NET.Sdk test harness needs the TRX extension used by CI and publish. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="MSBuild.StructuredLogger" />
    <!--
      AnalyzerRuleCoverageTests reflection-loads the nine mandatory analyzer packages to
      enumerate SupportedDiagnostics; Workspaces brings the Roslyn assemblies their
      analyzer/workspace references resolve against.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- Satisfies the analyzer packages' bundled workspace-layer references during reflection
    loading. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <!--
    Test discipline: a sleep or a wall-clock read makes a test slow or flaky, so RS0030 fails the
    build on one. A line that truly tests real time opts out with
    `#pragma warning disable RS0030 // real-wait: <why>` (or `wall-clock: <why>`); TestDisciplineTests
    rejects a suppression without that reason. String literals are consumer source, not test code,
    so the analyzer does not see the banned APIs inside them.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="..\..\src\Headless.NET.Sdk\configurations\BannedSymbols.TestTiming.txt" Visible="false" />
  </ItemGroup>
</Project>
